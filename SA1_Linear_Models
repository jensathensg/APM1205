# Part H. Two-Way ANOVA and Interactions

model_interaction <- lm(
  Rentals ~ Temperature * Season + Humidity + Wind,
  data = bike
)

summary(model_interaction)

temp_seq <- seq(min(bike$Temperature),
                max(bike$Temperature),
                length.out = 100)

pred_data <- expand.grid(
  Temperature = temp_seq,
  Season = levels(bike$Season)
)

pred_data$Humidity <- mean(bike$Humidity)
pred_data$Wind <- mean(bike$Wind)

pred_data$PredictedRentals <- predict(model_interaction, pred_data)

